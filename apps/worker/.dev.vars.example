# Copy this file to apps/worker/.dev.vars (gitignored) and fill in real dev values.
# For prod: use `wrangler secret put <NAME>`.

GITHUB_CLIENT_ID=your_dev_client_id
GITHUB_CLIENT_SECRET=your_dev_client_secret
SESSION_SECRET=generate_with_openssl_rand_base64_32
SESSION_VALID_SINCE=1970-01-01T00:00:00Z

# Billing (Stripe test mode only in dev). Leave BILLING_ENABLED empty to keep billing off; "1" turns it on.
BILLING_ENABLED=
STRIPE_SECRET_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_listen
STRIPE_PRICE_MONTHLY=price_monthly_test_id
STRIPE_PRICE_YEARLY=price_yearly_test_id
# Optional: older Pro price ids that still grant Pro, comma-separated.
# STRIPE_LEGACY_PRICE_IDS=price_old_monthly,price_old_yearly
# "1" turns on Stripe automatic tax in checkout; empty = off.
STRIPE_AUTOMATIC_TAX=
# "1" turns on Stripe Managed Payments (merchant of record; handles tax). Not with STRIPE_AUTOMATIC_TAX.
# STRIPE_MANAGED_PAYMENTS=1
# Optional: point at a local Stripe mock. Default https://api.stripe.com.
# STRIPE_API_BASE=http://localhost:12111
# Optional: this deploy's origin for every absolute link (OAuth redirects, Stripe
# return URLs, claim links, CORS). Default https://aired.sh.
# SITE_ORIGIN=http://localhost:8787

# WorkOS AuthKit sign-in (Phase 3). Off unless BOTH are set; then /auth/login
# and the CLI use AuthKit instead of GitHub. Staging: environment
# environment_01M89KX95ZKTZB0B7QP19VTTF8, redirect URI
# http://localhost:8787/auth/workos/callback (set SITE_ORIGIN to match).
# The API key is the staging sk_test_... from the WorkOS dashboard
# (API keys page); put it here, never in a committed file.
# WORKOS_CLIENT_ID=client_01M89KX9DYCW9Z8J3TEDHEDSD2
# WORKOS_API_KEY=sk_test_...
# Optional, local tests: point at a mock.
# WORKOS_API_BASE=http://localhost:12141

# Pro analytics (src/lib/analytics.ts). Production sets CF_ANALYTICS_TOKEN (a
# Cloudflare API token with Account Analytics Read) and CF_ACCOUNT_ID as
# secrets. Local Analytics Engine keeps nothing, so set ANALYTICS_DEMO=1 to
# get made-up numbers on /api/me/analytics instead.
# ANALYTICS_DEMO=1

# "Only these people" (private sharing by email code). EMAIL_MODE=log prints each
# code email to the wrangler dev console instead of sending it (needs SITE_ORIGIN
# set, so it can never run in production). For real sending, see the
# [[send_email]] block in wrangler.toml, or set RESEND_API_KEY as a fallback.
# EMAIL_MODE=log
# EMAIL_FROM=aired <access@aired.sh>
# RESEND_API_KEY=re_...
