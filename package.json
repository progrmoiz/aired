{
  "name": "aired",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aired/worker dev",
    "build": "pnpm run build:css && pnpm -r build",
    "build:css": "npx tailwindcss -c apps/web/tailwind.config.js -i apps/web/src/input.css -o apps/web/style.css --minify",
    "typecheck": "pnpm --filter @aired/core build && pnpm -r typecheck",
    "test": "pnpm --filter @aired/worker test"
  },
  "devDependencies": {
    "tailwindcss": "3",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@joplin/htmlpack@3.5.1": "patches/@joplin__htmlpack@3.5.1.patch"
    },
    "overrides": {
      "@base-ui/react>@babel/runtime": "8.1.0",
      "@base-ui/utils>@babel/runtime": "8.1.0",
      "bare-buffer": "3.7.1",
      "bare-fs": "4.8.4",
      "bare-path": "3.1.2",
      "bare-url": "2.5.6",
      "netmask": "2.1.1",
      "socks": "2.8.10",
      "tar-fs": "3.1.3",
      "tar-stream": "3.2.2"
    }
  }
}
